{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noEmit": true,

    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "baseUrl": ".",
    "paths": {
      "shared/*": ["shared/*"],
      "shared": ["shared"],
      "mock/*": ["mock/*"],
      "mock": ["mock"],
      "@mui/*": ["node_modules/@mui/*"],
      "@emotion/*": ["node_modules/@emotion/*"]
    }
  },

  "include": ["apps/**/*", "shared/**/*", "eslint.config.mjs"],
  "exclude": ["node_modules", ".next", "dist"]
}
