{
  "name": "parent-monitoring-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  
  "scripts": {
    "dev:shell": "npm --filter shell dev",
    "dev:dashboard": "npm --filter dashboard dev",
    "dev:notifications": "npm --filter notifications dev",
    "dev:all": "concurrently \"npm --filter shell dev\" \"npm --filter dashboard dev\" \"npm --filter notifications dev\"",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo .next **/node_modules **/.next"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "i18next": "25.6.2",
    "next": "15.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "16.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.4",
    "concurrently": "^8.2.2",
    "eslint": "^9.12.0",
    "eslint-config-next": "^14.2.6",
    "typescript": "^5.6.3"
  }
}
